<Window x:Class="SysLens.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SysLens.ViewModels"
        xmlns:views="clr-namespace:SysLens.Views"
        Title="SysLens" Icon="Assets/SysLens.ico" Height="800" Width="1440" MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="14">

    <Window.Resources>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="80" />
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="80" />
        </Style>

        <views:SeverityBrushConverter x:Key="SeverityBrush" CautionBrush="{StaticResource CautionBrush}"
                                      CriticalBrush="{StaticResource ErrorBrush}" />

        <!-- One USB node: name, VID:PID, status, hub tier and port on the first line, instance id below. -->
        <DataTemplate x:Key="UsbDeviceRow" DataType="{x:Type vm:UsbDeviceItem}">
            <StackPanel Background="Transparent">
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Ask AI" Click="UsbAskAi_Click" />
                        <MenuItem Header="Copy instance ID" Click="CopyInstanceId_Click" />
                    </ContextMenu>
                </StackPanel.ContextMenu>

                <StackPanel Orientation="Horizontal">
                    <!-- Glyphs: E950 component (root hub), E772 devices (hub), E88E USB (device) -->
                    <TextBlock Width="16" VerticalAlignment="Center" FontSize="14" Margin="0,0,6,0"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE88E;" />
                                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHub}" Value="True">
                                        <Setter Property="Text" Value="&#xE772;" />
                                        <Setter Property="Foreground" Value="{StaticResource FolderIconBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRootHub}" Value="True">
                                        <Setter Property="Text" Value="&#xE950;" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentStrongBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding Name}"
                               Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}, FallbackValue={StaticResource TextBrush}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHub}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding VidPid}" Margin="10,0,0,0" FontFamily="Consolas" VerticalAlignment="Center"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding StatusText}" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center"
                               Foreground="{Binding StatusSeverity, Converter={StaticResource SeverityBrush}, FallbackValue={StaticResource TertiaryTextBrush}}" />
                    <TextBlock Text="{Binding DepthText}" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center"
                               Foreground="{Binding DepthSeverity, Converter={StaticResource SeverityBrush}, FallbackValue={StaticResource TertiaryTextBrush}}" />
                    <TextBlock Text="{Binding Location}" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center"
                               Foreground="{StaticResource TertiaryTextBrush}" />
                    <!-- E897: help glyph -->
                    <Button Style="{StaticResource AiIconButton}" Content="&#xE897;" Margin="6,0,0,0" Padding="4,1"
                            ToolTip="Ask AI: what is this device, is its place in the USB tree a problem, how to fix it"
                            Click="UsbAskAi_Click" />
                </StackPanel>

                <TextBox Style="{StaticResource SelectableText}" Text="{Binding InstanceId, Mode=OneWay}" FontSize="11"
                         Margin="22,1,0,0" ToolTip="{Binding HubChainText}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <DockPanel Grid.ColumnSpan="2" Margin="2,0,2,10">
            <TextBlock Text="SysLens" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding PrivilegeStatus}" Foreground="{StaticResource SecondaryTextBrush}" Margin="16,0,0,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <TabControl Grid.Row="1">
            <!-- Disk usage -->
            <TabItem Header="Disk">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Drive picker -->
                    <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,0,10,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Refresh" Padding="10,3"
                                        IsEnabled="{Binding IsIdle}" Click="Refresh_Click" />
                                <TextBlock Text="Drives" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>

                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                <!-- Scan and Cancel share one slot: only one is visible at a time. -->
                                <Button Content="Scan" Style="{StaticResource PrimaryActionButton}" IsDefault="True"
                                        Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}" Click="Scan_Click" />
                                <Button Content="Cancel" Style="{StaticResource ActionButton}"
                                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" Click="Cancel_Click" />
                            </StackPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Drives}" IsEnabled="{Binding IsIdle}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DriveOption}">
                                            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,6" VerticalContentAlignment="Top">
                                                <StackPanel Margin="6,-2,0,0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                    <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Height="6" Width="230"
                                                                 HorizontalAlignment="Left" Margin="0,4" />
                                                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Results -->
                    <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Padding="4">
                        <TreeView ItemsSource="{Binding Results}" BorderThickness="0"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="Padding" Value="2,3" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type vm:FolderItem}" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{Binding FullPath}">
                                        <StackPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Open in Explorer" Click="OpenInExplorer_Click"
                                                          IsEnabled="{Binding HasPath}" />
                                                <MenuItem Header="Copy path" Click="CopyPath_Click"
                                                          IsEnabled="{Binding HasPath}" />
                                                <MenuItem Header="Ask AI" Click="AskAi_Click"
                                                          IsEnabled="{Binding HasPath}" />
                                            </ContextMenu>
                                        </StackPanel.ContextMenu>

                                        <Border Width="80" Height="10" Background="{StaticResource BarTrackBrush}" CornerRadius="2" VerticalAlignment="Center">
                                            <Border HorizontalAlignment="Left" Width="{Binding BarWidth}" CornerRadius="2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDrive}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource AccentStrongBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsFile}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource MutedBarBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Border>

                                        <TextBlock Text="{Binding SizeText}" Width="90" TextAlignment="Right" Margin="8,0,0,0"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding PercentText}" Width="62" TextAlignment="Right" Foreground="{StaticResource SecondaryTextBrush}" />

                                        <!-- Glyphs: E8B7 folder, E8A5 document, EDA2 hard drive -->
                                        <TextBlock Margin="12,0,0,0" Width="16" VerticalAlignment="Center" FontSize="15"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE8B7;" />
                                                    <Setter Property="Foreground" Value="{StaticResource FolderIconBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDrive}" Value="True">
                                                            <Setter Property="Text" Value="&#xEDA2;" />
                                                            <Setter Property="Foreground" Value="{StaticResource AccentStrongBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsFile}" Value="True">
                                                            <Setter Property="Text" Value="&#xE8A5;" />
                                                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasPath}" Value="False">
                                                            <Setter Property="Text" Value="" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Text="{Binding Name}" Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDrive}" Value="True">
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                            <Setter Property="FontSize" Value="16" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsFile}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsUnreadable}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Details}" Margin="10,0,0,0" Foreground="{StaticResource TertiaryTextBrush}" FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <!-- E897: help glyph -->
                                        <Button Style="{StaticResource AiIconButton}" Content="&#xE897;" Margin="6,0,0,0" Padding="4,1"
                                                ToolTip="Ask AI: what is this, can it be deleted, how to delete it safely"
                                                Visibility="{Binding HasPath, Converter={StaticResource BoolToVisibility}}"
                                                Click="AskAi_Click" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Border>

                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Status}" Margin="2,10,2,0"
                               Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                </Grid>
            </TabItem>

            <!-- USB device tree -->
            <TabItem Header="USB" DataContext="{Binding Usb}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" MinHeight="120" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" MinHeight="90" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="2,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Refresh" Padding="10,3" VerticalAlignment="Center"
                                IsEnabled="{Binding IsIdle}" Click="UsbRefresh_Click" />
                        <CheckBox DockPanel.Dock="Right" Content="Show disconnected" IsChecked="{Binding ShowDisconnected}"
                                  VerticalAlignment="Center" Padding="6,0,0,0" Margin="0,0,16,0"
                                  ToolTip="Also show devices that are not connected now, under the hub they were last on" />
                        <StackPanel>
                            <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Foreground="{StaticResource TertiaryTextBrush}" FontSize="12" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis">
                                <Run Text="Hub tiers count external hubs below the root hub; USB allows 5." />
                                <Run Text="Tier 4" Foreground="{StaticResource CautionBrush}" />
                                <Run Text="is close to the limit;" />
                                <Run Text="tier 5 and device errors" Foreground="{StaticResource ErrorBrush}" />
                                <Run Text="are where devices drop off." />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>

                    <!-- Connected devices -->
                    <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="4">
                        <TreeView ItemsSource="{Binding Roots}">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="Padding" Value="2,3" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type vm:UsbDeviceItem}" ItemsSource="{Binding Children}">
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource UsbDeviceRow}">
                                        <!-- Disconnected devices, shown under their last hub, are dimmed. -->
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPresent}" Value="False">
                                                        <Setter Property="Opacity" Value="0.55" />
                                                        <Setter Property="FontStyle" Value="Italic" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Border>

                    <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" ResizeDirection="Rows" />

                    <!-- Devices no longer connected -->
                    <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Padding="4">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="8,4,8,6">
                                <TextBlock Text="History" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Margin="12,0,0,0" FontSize="12" Foreground="{StaticResource TertiaryTextBrush}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <Run Text="Devices not connected now, latest first." />
                                    <Run Text="Removed within seconds of arriving" Foreground="{StaticResource ErrorBrush}" />
                                    <Run Text="usually means the device failed to enumerate." />
                                </TextBlock>
                            </DockPanel>
                            <ListBox ItemsSource="{Binding History}" HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:UsbDeviceItem}">
                                        <StackPanel Margin="4,3">
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource UsbDeviceRow}" />
                                            <TextBlock Text="{Binding HistoryText}" FontSize="12" Margin="22,1,0,0"
                                                       Foreground="{Binding StatusSeverity, Converter={StaticResource SeverityBrush}, FallbackValue={StaticResource SecondaryTextBrush}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <TextBlock Grid.Row="4" Text="{Binding Status}" Margin="2,10,2,0"
                               Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                </Grid>
            </TabItem>
        </TabControl>

        <!-- AI assistant, shared by both tabs -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelBorder}" Width="470" Margin="10,0,0,0"
                Visibility="{Binding Assistant.IsOpen, Converter={StaticResource BoolToVisibility}}">
            <views:AssistantPanel DataContext="{Binding Assistant}" />
        </Border>
    </Grid>
</Window>
