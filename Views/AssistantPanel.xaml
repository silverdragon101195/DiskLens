<UserControl x:Class="SysLens.Views.AssistantPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;"
                    ToolTip="Close" VerticalAlignment="Top" Click="Close_Click" />
            <StackPanel>
                <TextBlock Text="Ask AI" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Topic.Subject}" ToolTip="{Binding Topic.Subject}"
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"
                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Input -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Send" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                    VerticalAlignment="Center" MinWidth="64"
                    Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}" Click="Send_Click" />
            <Button DockPanel.Dock="Right" Content="Stop" Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="64"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Click="Stop_Click" />
            <TextBox x:Name="InputBox" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                     ToolTip="Ask a follow-up question (Enter to send, Shift+Enter for a new line)"
                     PreviewKeyDown="InputBox_PreviewKeyDown" />
        </DockPanel>

        <!-- Conversation -->
        <RichTextBox x:Name="Transcript" IsReadOnly="True" IsDocumentEnabled="True"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     Foreground="{StaticResource TextBrush}"
                     VerticalScrollBarVisibility="Auto" />
    </DockPanel>
</UserControl>
