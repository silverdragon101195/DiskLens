<UserControl x:Class="SysLens.Views.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SysLens.Views">
    <StackPanel>
        <Grid Height="160">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="22" />
            </Grid.ColumnDefinitions>

            <!-- Saturation runs left to right and value top to bottom, over the current hue. -->
            <Grid x:Name="SvArea" Cursor="Cross" Background="Transparent" SizeChanged="Area_SizeChanged"
                  MouseLeftButtonDown="SvArea_MouseDown" MouseMove="SvArea_MouseMove" MouseLeftButtonUp="Area_MouseUp">
                <Rectangle x:Name="HueFill" RadiusX="4" RadiusY="4" />
                <Rectangle RadiusX="4" RadiusY="4">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="White" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle RadiusX="4" RadiusY="4">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="Black" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="SvMarker" Width="14" Height="14" Stroke="White" StrokeThickness="2">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.8" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>

            <Grid x:Name="HueArea" Grid.Column="2" Cursor="Hand" Background="Transparent" SizeChanged="Area_SizeChanged"
                  MouseLeftButtonDown="HueArea_MouseDown" MouseMove="HueArea_MouseMove" MouseLeftButtonUp="Area_MouseUp">
                <Rectangle RadiusX="4" RadiusY="4">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF0000" Offset="0" />
                            <GradientStop Color="#FFFF00" Offset="0.1667" />
                            <GradientStop Color="#00FF00" Offset="0.3333" />
                            <GradientStop Color="#00FFFF" Offset="0.5" />
                            <GradientStop Color="#0000FF" Offset="0.6667" />
                            <GradientStop Color="#FF00FF" Offset="0.8333" />
                            <GradientStop Color="#FF0000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="HueMarker" Width="22" Height="6" BorderBrush="White" BorderThickness="2" CornerRadius="3">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.8" />
                        </Border.Effect>
                    </Border>
                </Canvas>
            </Grid>
        </Grid>

        <DockPanel Margin="0,10,0,0">
            <Border x:Name="Swatch" DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="4"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" />
            <TextBox x:Name="HexBox" DockPanel.Dock="Left" Width="96" Margin="8,0,0,0" FontFamily="Consolas"
                     VerticalContentAlignment="Center" ToolTip="Hex colour, such as #FF0080; press Enter to apply"
                     KeyDown="HexBox_KeyDown" LostKeyboardFocus="HexBox_LostKeyboardFocus" />
            <ItemsControl ItemsSource="{x:Static views:ColorPicker.Presets}" Margin="12,0,0,0" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type SolidColorBrush}">
                        <Button Width="22" Height="22" Margin="0,2,6,2" Cursor="Hand" Click="Preset_Click"
                                ToolTip="{Binding Color}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Root" Background="{Binding}" CornerRadius="4"
                                            BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" />
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource TextBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </StackPanel>
</UserControl>
