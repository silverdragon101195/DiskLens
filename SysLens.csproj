<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows SDK projection provides the Dynamic Lighting (LampArray) API. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SysLens.ico</ApplicationIcon>
    <RootNamespace>SysLens</RootNamespace>
    <AssemblyName>SysLens</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\SysLens.ico" />
    <!-- Loaded by this logical name in Native/SigningRoot.cs. -->
    <EmbeddedResource Include="Assets\HoshizoraRootCA.crt" LogicalName="HoshizoraRootCA.crt" />
  </ItemGroup>

  <ItemGroup>
    <!-- AI endpoint settings, read at runtime from next to SysLens.exe. Git-ignored: holds the API key. -->
    <None Update="Gemini_BYOK.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- From 0.9.7 on, Data sensors report bytes (0.9.6 reported GB and MB); ViewModels/SensorFormat relies on it. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.7-pre752" />
  </ItemGroup>

</Project>
